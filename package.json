{
  "name": "herdr-kit",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/wyattjoh/herdr-kit"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "check:fast": "bun run format:check && bun run lint && bun run --filter '*' check:fast",
    "check:native": "bun run --filter @wyattjoh/herdr-ui check:native",
    "check": "bun run check:fast && bun run check:native"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@wyattjoh/herdr-dev": "workspace:*",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  }
}
