{
  "name": "@wyattjoh/herdr-ui",
  "version": "0.2.0",
  "description": "The Tasks panel's visual system for Herdr mods: theme tokens, controls, chrome, listing cards, chips, tabs, menus, scroll regions, state blocks and icons.",
  "keywords": [
    "gpui",
    "gpui-kit",
    "herdr",
    "ui"
  ],
  "homepage": "https://github.com/wyattjoh/herdr-ui#readme",
  "bugs": "https://github.com/wyattjoh/herdr-ui/issues",
  "license": "MIT",
  "author": "Wyatt Johnson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyattjoh/herdr-ui.git"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/test/**",
    "assets/icons/*.svg",
    "licenses/*.txt",
    "NOTICE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./pure": "./src/pure.ts",
    "./assets": "./src/assets.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "bun scripts/typecheck.ts",
    "typecheck:bun": "tsc --noEmit",
    "test": "bun test src scripts",
    "pack:check": "bun scripts/pack-check.ts",
    "mod:check": "bun scripts/gallery.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run pack:check && bun run mod:check"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  }
}
